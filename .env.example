# CodeGen Hub Configuration

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# Database (SQLite path relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./codegen_hub.db

# Workspace (leave empty for app-managed temp directory)
WORKSPACE_PATH=

# Encryption key for storing secrets (auto-generated on first run if empty)
ENCRYPTION_KEY=
